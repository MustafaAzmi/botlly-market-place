# ============================================================
# Botly — Environment Variables
# Copy this file to `.env` (local) and fill the values.
# On Netlify: Site configuration → Environment variables.
# NEVER commit the real `.env` — it is gitignored.
# ============================================================

# --- Supabase (database) -----------------------------------
# From: Supabase project → Project Settings → API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side (browser) — same project, public values
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Admin bootstrap (server-only, only for an empty database) -------
ADMIN_BOOTSTRAP_WHATSAPP=
ADMIN_BOOTSTRAP_PASSWORD=

# --- WhatsApp Cloud API ------------------------------------
# From: developers.facebook.com → your app → Use cases → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=<your-phone-number-id>
# Permanent token: business.facebook.com → Business Settings → System Users → Generate Token
# (scopes: whatsapp_business_messaging + whatsapp_business_management)
WHATSAPP_ACCESS_TOKEN=
# App Secret: developers.facebook.com → App settings → Basic → App Secret (Show)
WHATSAPP_APP_SECRET=
# Any random string you choose. Must match the value entered in Meta → Webhooks config.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WhatsApp Business Account ID (WABA) — from WhatsApp Manager URL (asset_id)
WHATSAPP_WABA_ID=<your-waba-id>

# --- OpenAI (primary AI: intent extraction + caption analysis)
# From: platform.openai.com → API keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Legacy (not used — kept for reference) ----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001
