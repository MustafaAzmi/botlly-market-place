{
  "id": "botly-customer",
  "name": "بوتلي زبون",
  "short_name": "بوتلي",
  "description": "دور على قطع سيارتك واطلبها — بوتلي يوصلها إلك لغاية عندك.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/customer/auth",
  "scope": "/customer/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#16a34a",
  "categories": ["shopping"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/customer.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    {
      "src": "/icons/customer-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    { "src": "/icons/customer-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/customer-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/icons/customer-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
